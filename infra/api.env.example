# Copy to ~/.config/nexusz/api.env and edit. KEY=value lines only (no quotes, no export, no secrets).
# Every setting is optional; the defaults give the stub backend on 127.0.0.1:8000.
NEXUSZ_BACKEND=model
NEXUSZ_DATA_DIR=/home/YOUR_USER/data
NEXUSZ_SLICE=HI-Slice
NEXUSZ_BUNDLE=/home/YOUR_USER/bundle
# Demo scenario: use the first 24 hours as history and replay the rest with infra/simulator.py
NEXUSZ_HISTORY_HOURS=24
NEXUSZ_ACTIVE_HOURS=24
NEXUSZ_MIN_REFRESH_SECONDS=5
NEXUSZ_PORT=8000
# Extra browser origins allowed to call the API (comma separated)
# NEXUSZ_CORS_ORIGINS=http://localhost:4000
